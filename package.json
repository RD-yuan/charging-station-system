{
  "name": "charging-station-system",
  "private": true,
  "version": "0.1.0",
  "description": "Smart charging pile dispatch and billing system monorepo.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "npm --workspace apps/client run dev",
    "dev:server": "npm --workspace apps/server run start:dev",
    "build": "npm-run-all build:client build:server",
    "build:client": "npm --workspace apps/client run build",
    "build:server": "npm --workspace apps/server run build",
    "lint": "npm-run-all lint:client lint:server",
    "lint:client": "npm --workspace apps/client run lint",
    "lint:server": "npm --workspace apps/server run lint",
    "test": "npm --workspace apps/server run test"
  },
  "overrides": {
    "@nestjs/common": "^11.1.26"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "npm-run-all": "^4.1.5"
  }
}
