generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ChargeMode {
  FAST
  SLOW
}

enum OrderStatus {
  WAITING
  IN_PILE_QUEUE
  CHARGING
  FINISHED
  CANCELED
  ABORTED
}

enum PhysicalState {
  ON
  OFF
}

enum WorkingState {
  IDLE
  CHARGING
  FAULT
}

enum SessionStatus {
  ACTIVE
  CLOSED
  ABORTED
}

enum BillingPeriod {
  PEAK
  FLAT
  VALLEY
}

model User {
  id              String          @id @default(cuid())
  username        String          @unique
  passwordHash    String
  role            String          @default("USER")
  batteryCapacity Float           @default(60)
  orders          ChargingOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Administrator {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  adminName    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChargingPile {
  id                    String         @id
  pileType              ChargeMode
  power                 Float
  physicalState         PhysicalState  @default(OFF)
  workingState          WorkingState   @default(IDLE)
  totalChargeCount      Int            @default(0)
  totalChargeDuration   Float          @default(0)
  totalChargeAmount     Float          @default(0)
  orders                ChargingOrder[]
  sessions              ChargingSession[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ChargingOrder {
  id              String             @id @default(cuid())
  userId          String
  chargeMode      ChargeMode
  requestedAmount Float
  queueNo         String
  status          OrderStatus        @default(WAITING)
  assignedPileId       String?
  pileQueueEnteredAt   DateTime?
  submitTime           DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  user            User               @relation(fields: [userId], references: [id])
  assignedPile    ChargingPile?      @relation(fields: [assignedPileId], references: [id])
  sessions        ChargingSession[]
  detail          BillingDetail?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([queueNo])
  @@index([status])
  @@index([chargeMode, status])
}

model ChargingSession {
  id            String         @id @default(cuid())
  orderId       String
  pileId        String
  startTime     DateTime      @default(now())
  stopTime      DateTime?
  actualAmount  Float?
  stopReason    String?
  sessionStatus SessionStatus  @default(ACTIVE)
  order         ChargingOrder @relation(fields: [orderId], references: [id])
  pile          ChargingPile  @relation(fields: [pileId], references: [id])
  detail        BillingDetail?

  @@index([pileId, sessionStatus])
  @@index([orderId, sessionStatus])
}

model BillingDetail {
  id                String          @id @default(cuid())
  orderId           String          @unique
  sessionId         String          @unique
  generatedAt       DateTime        @default(now())
  actualAmount      Float
  duration          Float
  chargeFee         Float
  serviceFee        Float
  totalFee          Float
  billingRuleVersion Int            @default(1)
  order             ChargingOrder   @relation(fields: [orderId], references: [id])
  session           ChargingSession @relation(fields: [sessionId], references: [id])
}

model BillingRule {
  id             String        @id @default(cuid())
  period         BillingPeriod
  startMinute    Int
  endMinute      Int
  price          Float
  serviceFeeRate Float         @default(0.8)
  version        Int
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([active, version])
}
